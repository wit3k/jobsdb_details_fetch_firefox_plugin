{
  "manifest_version": 3,
  "name": "JobsDB Extractor",
  "version": "1.1.1",
  "description": "Extract job offer details from JobsDB (HK/TH).",
  "browser_specific_settings": {
    "gecko": {
      "id": "jobsdb-extractor@local",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": ["activeTab", "tabs", "clipboardWrite", "storage"],
  "host_permissions": [
    "*://hk.jobsdb.com/*",
    "*://th.jobsdb.com/*",
    "*://*.jobsdb.com/*"
  ],
  "background": {
    "scripts": ["background/background.js"]
  },
  "action": {
    "default_title": "JobsDB Extractor",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png"
    }
  },
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://hk.jobsdb.com/*",
        "*://th.jobsdb.com/*",
        "*://*.jobsdb.com/*"
      ],
      "js": ["content/extract.js", "content/content.js"],
      "css": ["content/content.css"],
      "run_at": "document_idle"
    }
  ]
}
