{
  "manifest_version": 3,
  "name": "Job Extractor",
  "version": "1.2.3",
  "description": "Extract job offer details from JobsDB (HK/TH) and LinkedIn.",
  "browser_specific_settings": {
    "gecko": {
      "id": "jobsdb-extractor@local",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": ["activeTab", "tabs", "clipboardWrite", "storage", "downloads"],
  "host_permissions": [
    "*://hk.jobsdb.com/*",
    "*://th.jobsdb.com/*",
    "*://*.jobsdb.com/*",
    "*://*.linkedin.com/*",
    "*://linkedin.com/*"
  ],
  "background": {
    "scripts": ["background/background.js"]
  },
  "action": {
    "default_title": "Job Extractor",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png"
    }
  },
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://hk.jobsdb.com/*",
        "*://th.jobsdb.com/*",
        "*://*.jobsdb.com/*"
      ],
      "js": ["content/extract.js", "content/content.js"],
      "css": ["content/content.css"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.linkedin.com/jobs/*",
        "*://linkedin.com/jobs/*"
      ],
      "js": [
        "content/extract.js",
        "content/extract-linkedin.js",
        "content/content.js"
      ],
      "css": ["content/content.css"],
      "run_at": "document_idle"
    }
  ]
}
